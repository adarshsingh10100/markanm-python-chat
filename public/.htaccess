# MarkanM Chat Apache Rewrite Rules for Hostinger Shared Hosting

# Ensure correct MIME types for JS/CSS assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass Authorization header to PHP (Crucial for Hostinger FastCGI / PHP-FPM)
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # 1. Direct API routes to PHP REST API router
  RewriteRule ^api/v1/(.*)$ backend/index.php [QSA,L]
  RewriteRule ^api/(.*)$ backend/index.php [QSA,L]
  RewriteRule ^backend/api/(.*)$ backend/index.php [QSA,L]

  # 2. Serve static files directly if existing (assets, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Fallback all React SPA page routes to index.html
  RewriteRule ^ index.html [L]
</IfModule>
